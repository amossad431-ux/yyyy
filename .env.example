# ==========================================================================
# إعدادات Cartat WhatsApp API
# انسخ هذا الملف إلى ".env" ثم املأ القيم. ملف .env لا يُرفع على git إطلاقاً.
# احصل على التوكن من: https://app.cartat.net/store/api
# ==========================================================================

# التوكن الخاص بك (سرّي — لا تشاركه مع أحد)
CARTAT_TOKEN=ضع_التوكن_هنا

# الرابط الأساسي لـ API (راجع docs.cartat.net إن اختلف)
CARTAT_BASE_URL=https://hub.cartat.net

# مسار إرسال الرسالة النصية (راجع docs.cartat.net وعدّله إن لزم)
CARTAT_SEND_PATH=/api/send

# طريقة تمرير التوكن: bearer | header | query | body
#   bearer -> Authorization: Bearer <token>
#   header -> ترويسة مخصّصة (يحدّد اسمها CARTAT_TOKEN_HEADER)
#   query  -> ضمن رابط الطلب ?token=<token>
#   body   -> ضمن جسم الطلب باسم الحقل CARTAT_TOKEN_FIELD
CARTAT_AUTH_MODE=bearer

# اسم الترويسة عند اختيار header
CARTAT_TOKEN_HEADER=Authorization

# أسماء الحقول في جسم الطلب (عدّلها لتطابق التوثيق إن اختلفت)
CARTAT_PHONE_FIELD=phone
CARTAT_MESSAGE_FIELD=message
CARTAT_TOKEN_FIELD=token

# كود الدولة الافتراضي (بدون +) يُضاف للأرقام التي لا تبدأ بكود دولة
DEFAULT_COUNTRY_CODE=20

# التأخير بين كل رسالة والتي تليها بالمللي ثانية (يحمي رقمك من الحظر)
SEND_DELAY_MS=4000

# منفذ خادم الويب
PORT=3000
