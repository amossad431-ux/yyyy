{name:"Thomas from Jacksonville, FL, USA",time:"2 hours ago"},
{name:"Graham from Brisbane, QLD, Australia",time:"3 hours ago"},
{name:"William from Ottawa, ON, Canada",time:"3 hours ago"}
];
var pop=document.getElementById("spPop"),
    nameEl=document.getElementById("spName"),
    timeEl=document.getElementById("spTime"),
    closeBtn=document.getElementById("spClose"),
    i=0,stopped=false,timer=null,
    SHOW_MS=6000,          /* how long each popup stays visible */
    FIRST_DELAY=5000,      /* delay before the first popup */
    GAP=54000;             /* hidden time so a popup appears once every 60s */
orders.sort(function(){return Math.random()-.5});
function show(){
  if(stopped)return;
  var o=orders[i%orders.length];i++;
  nameEl.textContent=o.name;
  timeEl.textContent=o.time;
  pop.classList.add("sp-show");
  timer=setTimeout(function(){
    pop.classList.remove("sp-show");
    timer=setTimeout(show,GAP);
  },SHOW_MS);
}
